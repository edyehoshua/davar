{
  "name": "davar",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "expo start --port 8082",
    "start:clear": "expo start --port 8082 --clear",
    "start:android:localhost": "expo start --dev-client --localhost --port 8081 --clear",
    "ios": "expo run:ios",
    "ios:clean": "expo prebuild --clean --platform ios && expo run:ios --no-build-cache",
    "android": "REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:android",
    "android:clean": "expo prebuild --clean --platform android && REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:android",
    "android:reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8082 tcp:8082 && adb reverse tcp:3002 tcp:3002",
    "android:logs": "adb logcat | grep -Ei 'ReactNativeJS|AndroidRuntime|OkHttp|Expo|bible.davar'",
    "web": "expo start --web --port 8082",
    "lint": "expo lint",
    "typecheck": "bunx tsc --noEmit",
    "format": "bunx biome format --write .",
    "format:check": "bunx biome format .",
    "preflight": "bun typecheck && bun lint",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:all": "eas build --platform all --profile production",
    "build:ios:prod": "eas build --platform ios --profile production",
    "build:android:prod": "eas build --platform android --profile production",
    "build:all:prod": "eas build --platform all --profile production",
    "build:ios:local": "eas build --platform ios --profile preview --local",
    "build:android:local": "eas build --platform android --profile preview --local",
    "build:all:local": "eas build --platform all --profile preview --local",
    "update:dev": "eas update --channel development",
    "update:preview": "eas update --channel preview",
    "update:prod": "eas update --channel production",
    "reset-project": "bun ./scripts/reset-project.js"
  },
  "dependencies": {
    "@expo-google-fonts/arimo": "^0.4.2",
    "@expo-google-fonts/cardo": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jost": "^0.4.2",
    "@expo-google-fonts/suez-one": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "7.15.8",
    "@react-navigation/elements": "2.9.13",
    "@react-navigation/native": "7.2.1",
    "expo": "^54.0.34",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-mail-composer": "~15.0.8",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.17",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-circular-progress": "^1.4.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-markdown-display": "7.0.2",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "~19.1.17",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "typescript": "~5.9.3"
  },
  "private": true
}

{
  "expo": {
    "name": "Davar",
    "slug": "Davar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "davar",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bible.davar",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "SYSTEM_ALERT_WINDOW",
        "VIBRATE"
      ],
      "package": "bible.davar"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7AA0D6",
          "ios": {
            "image": "./assets/images/splash-native-ios.png",
            "resizeMode": "cover",
            "backgroundColor": "#7AA0D6",
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "image": "./assets/images/davar_nobackground.png",
            "resizeMode": "contain",
            "backgroundColor": "#7AA0D6"
          }
        }
      ],
      "expo-font",
      "expo-mail-composer",
      "expo-sqlite",
      "expo-web-browser"
    ],
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/232e7627-d0c9-4b88-976e-b4855beb322e",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "232e7627-d0c9-4b88-976e-b4855beb322e"
      }
    }
  }
}
